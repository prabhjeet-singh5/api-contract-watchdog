# Copy to .env for local configuration. Never commit .env.
# Checker settings (active from Phase 3).
DUMMYJSON_BASE_URL=https://dummyjson.com
# Network inactivity timeout in seconds, applied to connect/read/write/pool.
REQUEST_TIMEOUT_SECONDS=10
# A completed response fails if it exceeds this duration in milliseconds.
MAX_RESPONSE_TIME_MS=2000
# Baselines (Phase 4), run state, and run history (Phase 5) are stored under STATE_DIR.
STATE_DIR=data

# Mock API (Phase 6). Base URL of a deployed mock, for later CI phases.
MOCK_API_BASE_URL=
# At least 16 characters; empty disables admin routes. Use the same value on the server.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MOCK_API_ADMIN_TOKEN=
# Local server address; hosting platforms usually need 0.0.0.0 and set PORT.
MOCK_API_HOST=127.0.0.1
PORT=8000

# Alerts (Phase 7): n8n first, Slack as fallback. Blank means unset; keep both secret.
# N8N_WEBHOOK_URL is the Production URL of the imported n8n workflow (Phase 8).
N8N_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Optional local run link; GitHub Actions will supply its own run link.
RUN_URL=
